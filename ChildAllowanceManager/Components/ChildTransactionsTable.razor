@inherits IAsyncDisposable
@implements IBrowserViewportObserver


<div class="transactions-table-shell">
<MudTable @ref="@_table"
          Class="transactions-table"
          RowsPerPage="25" 
          Hover="true" 
          Breakpoint="Breakpoint.Sm" 
          LoadingProgressColor="Color.Primary"
          Striped="true"
          ServerData="RetrievePage"
>
    <HeaderContent>
        <caption>Transactions for @Child?.Name, newest first</caption>
        <MudTh scope="col">When</MudTh>
        <MudTh scope="col">Movement</MudTh>
        <MudTh scope="col">Details</MudTh>
        @if (!IsSmallSize)
        {
            <MudTh scope="col">Balance</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        @{ var localTime = context.TransactionTimestamp.ToLocalTime(); }
        <MudTd DataLabel="When" Class="transaction-when">
            <MudText Class="transaction-date">@localTime.ToString("d MMM HH:mm")</MudText>
        </MudTd>
        <MudTd DataLabel="Movement" Class="transaction-movement-cell">
            <div class="transaction-movement @(context.TransactionAmount > 0 ? "transaction-in" : context.TransactionAmount < 0 ? "transaction-out" : "transaction-neutral")"
                 aria-label="@(context.TransactionAmount > 0 ? "Money in" : context.TransactionAmount < 0 ? "Money out" : "No change")">
                <span class="transaction-direction" aria-hidden="true">
                    <MudIcon Icon="@(context.TransactionAmount > 0 ? Icons.Material.Filled.ArrowUpward : context.TransactionAmount < 0 ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.Remove)" Size="Size.Small" aria-hidden="true" />
                </span>
                <MudText Class="transaction-amount">
                    @(context.TransactionAmount > 0 ? "+" : "")@context.TransactionAmount.ToString("C2")
                </MudText>
            </div>
        </MudTd>
        <MudTd DataLabel="Details" Class="transaction-details" title="@context.Description">
            <MudText Class="transaction-description">@context.Description</MudText>
        </MudTd>
        @if (!IsSmallSize)
        {
            <MudTd DataLabel="Balance" Class="transaction-balance-cell">
                <MudText Class="transaction-balance">@context.Balance.ToString("C2")</MudText>
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <div class="skeleton-stack" role="status" aria-label="Loading transactions">
            <span class="skeleton-block skeleton-line skeleton-line-wide"></span>
            <span class="skeleton-block skeleton-line skeleton-line-medium"></span>
            <span class="skeleton-block skeleton-line skeleton-line-short"></span>
        </div>
    </LoadingContent>
    <PagerContent>
        <MudTablePager Class="pa-4"/>
    </PagerContent>
</MudTable>
</div>
