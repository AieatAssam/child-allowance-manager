@inherits IAsyncDisposable
@implements IBrowserViewportObserver


<div class="transactions-table-shell">
<MudTable @ref="@_table"
          Class="transactions-table"
          RowsPerPage="25" 
          Hover="true" 
          Breakpoint="Breakpoint.Sm" 
          LoadingProgressColor="Color.Info"
          Striped="true"
          ServerData="RetrievePage"
>
    <HeaderContent>
        <MudTh>When</MudTh>
        <MudTh>Movement</MudTh>
        <MudTh>Details</MudTh>
        <MudTh>Balance after</MudTh>
    </HeaderContent>
    <RowTemplate>
        @{ var localTime = context.TransactionTimestamp.ToLocalTime(); }
        <MudTd DataLabel="When" Class="transaction-when">
            <MudText Class="transaction-date">@localTime.ToString("ddd, d MMM")</MudText>
            <MudText Class="transaction-time">@localTime.ToString("t")</MudText>
        </MudTd>
        <MudTd DataLabel="Movement" Class="transaction-movement-cell">
            <div class="transaction-movement @(context.TransactionAmount > 0 ? "transaction-in" : context.TransactionAmount < 0 ? "transaction-out" : "transaction-neutral")">
                <span class="transaction-direction" aria-hidden="true">
                    <MudIcon Icon="@(context.TransactionAmount > 0 ? Icons.Material.Filled.ArrowUpward : context.TransactionAmount < 0 ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.Remove)" Size="Size.Small" />
                </span>
                <div>
                    <MudText Class="transaction-amount">
                        @(context.TransactionAmount > 0 ? "+" : "")@context.TransactionAmount.ToString("C2")
                    </MudText>
                    <MudText Class="transaction-movement-label">
                        @(context.TransactionAmount > 0 ? "Money in" : context.TransactionAmount < 0 ? "Money out" : "No change")
                    </MudText>
                </div>
            </div>
        </MudTd>
        <MudTd DataLabel="Details" Class="transaction-details">
            <MudText Class="transaction-description">@context.Description</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="transaction-type-chip">
                @FormatTransactionType(context.TransactionType)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Balance after" Class="transaction-balance-cell">
            <MudText Class="transaction-balance">@context.Balance.ToString("C2")</MudText>
            <MudText Class="transaction-balance-caption">after this</MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager Class="pa-4"/>
    </PagerContent>
</MudTable>
</div>
