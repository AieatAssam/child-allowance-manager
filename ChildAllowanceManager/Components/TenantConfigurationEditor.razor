<MudForm FieldChanged="args => OnTenantChanged()"
         ReadOnly="@ReadOnly"
         Validation="@(Validator.ValidateValue)"
         Model="@Tenant"
         ValidationDelay="0"
         @ref="@_form">
    <MudTextField @bind-Value="Tenant.TenantName"
                  For="() => Tenant.TenantName"
                  Label="Name"
                  Immediate="false"></MudTextField>
    <MudTextField @bind-Value="Tenant.UrlSuffix"
                  For="() => Tenant.UrlSuffix"
                  Label="URL Suffix"
                  Immediate="false" />
    <MudSelect T="string"
               @bind-Value="Tenant.TimeZoneId"
               Label="Time zone"
               HelperText="Allowances are paid just after midnight in this zone."
               ReadOnly="@ReadOnly">
        @foreach (var timeZone in TimeZones)
        {
            <MudSelectItem T="string" Value="@timeZone.Id">@timeZone.DisplayName</MudSelectItem>
        }
    </MudSelect>
    @if (!ReadOnly)
    {
        <MudText Typo="Typo.subtitle1" Class="mt-1 pt-1">Parents</MudText>
        <MudChipSet T="string">
            @foreach (var parent in _parents)
            {
                <MudChip Color="Color.Primary"
                         Variant="Variant.Filled"
                         Class="ma-1"
                         Value="@parent.Id"
                         Text="@parent.Email"
                         OnClose="RemoveParentAsync"
                         T="string">
                </MudChip>
            }
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddParentDialogue">
                Add parent
            </MudButton>
        </MudChipSet>
    }
</MudForm>
