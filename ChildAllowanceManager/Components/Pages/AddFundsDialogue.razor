<AppDialog Title="Add Funds" PrimaryActionText="Add" OnPrimary="AddFunds" IsBusy="@IsBusy">
    <ChildContent>
        <MudForm @ref="_form">
            <MudNumericField Label="Amount"
                             @bind-Value="Amount"
                             Min="0.1m"
                             Required="true"
                             InputMode="@(InputMode.@decimal)"
                             Immediate="true"/>
            <MudText Typo="Typo.caption">@($"{Child.Balance:C2} + {Amount:C2} = {Child.Balance + Amount:C2}")</MudText>
            <MudTooltip Text="Round Up">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowCircleUp"
                               aria-label="Round up amount"
                               Color="Color.Success"
                               OnClick="RoundUp"></MudIconButton>
            </MudTooltip>
            <MudTextField Label="Description"
                          @bind-Value="Description"
                          Required="true"/>
        </MudForm>
        @if (IsBusy) { <MudProgressLinear Indeterminate="true" Class="mt-2" aria-label="Saving" /> }
    </ChildContent>
</AppDialog>
