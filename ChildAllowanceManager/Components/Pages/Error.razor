@page "/error"
@page "/error/{Code?}"

<PageTitle>Error</PageTitle>

<div class="page-shell">
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <MudText Typo="Typo.h6" HtmlTag="h1">@(Code == "404" ? "Page not found" : "Something went wrong")</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            @(Code == "404" ? "That page does not exist." : "Something went wrong. Nothing was changed.")
        </MudText>
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="/">
            Back to families
        </MudButton>
    </MudAlert>
</div>

@code{
    [Parameter] public string? Code { get; set; }

}
