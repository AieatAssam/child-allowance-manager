@page "/error"
@page "/error/{Code?}"

<PageTitle>Error</PageTitle>

<div class="page-shell">
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        @if (Code == "404")
        {
            <MudText Typo="Typo.h6" HtmlTag="h1">That page does not exist.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h6" HtmlTag="h1">Something went wrong.</MudText>
            <MudText Typo="Typo.body2" Class="mt-2">Please try again.</MudText>
        }
    </MudAlert>
</div>

@code{
    [Parameter] public string? Code { get; set; }

}
