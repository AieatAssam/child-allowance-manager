@page "/{tenantSuffix}/configuration"
@using ChildAllowanceManager.Common.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin,parent")]
<PageTitle>Family settings</PageTitle>

<div class="page-shell settings-view">
    <div class="page-heading">
        <div class="page-heading-copy">
            <MudText Typo="Typo.h3" HtmlTag="h1" Class="page-title">Family settings</MudText>
        </div>
    </div>

<MudTabs Class="settings-tabs">
    <MudTabPanel Icon="@Icons.Material.Filled.ChildCare" Text="Children" BadgeData="Children?.Count()">
        <MudPaper Class="settings-card" Elevation="0">
            <MudToolBar>
                <MudText Typo="Typo.subtitle1" HtmlTag="h2">Children</MudText>
                <MudSpacer/>
                <MudIconButton Icon="@Icons.Material.Outlined.Add" aria-label="Add child" Disabled="@IsBusy" OnClick="() => AddingChild = true"/>
            </MudToolBar>

            @if (Children == null)
            {
                @if (LoadError is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        We couldn’t load the children. Check your connection and try again.
                        <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@IsBusy"
                                   OnClick="ReloadChildren">Try again</MudButton>
                    </MudAlert>
                }
                else
                {
                    <div class="skeleton-stack" role="status" aria-label="Loading children">
                        <span class="skeleton-block skeleton-line skeleton-line-wide"></span>
                        <span class="skeleton-block skeleton-line skeleton-line-medium"></span>
                        <span class="skeleton-block skeleton-line skeleton-line-short"></span>
                    </div>
                }
            }
            else if (Children.Any() || AddingChild)
            {
                <MudCollapse Expanded="AddingChild">
                    <MudCard>
                        <MudCardHeader>
                        <MudText Typo="Typo.h5">Add a child</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <ChildConfigurationEditor @bind-Child="NewChild"></ChildConfigurationEditor>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsBusy" OnClick="async () => await AddChild()">Save</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="() => NewChild = new ChildConfiguration()">Clear</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudCollapse>
                
                <MudExpansionPanels MultiExpansion="true">
                    @for (int idx = 0; idx < Children.Length; idx++)
                    {
                        var idxLocal = idx;
                        <MudExpansionPanel Class="settings-panel">
                            <TitleContent>
                                <div class="d-flex">
                                    <MudIcon Icon="@(ChildBeingEditedId == Children[idxLocal].Id ? Icons.Material.Filled.Edit : Icons.Material.Filled.Person)"
                                             Class="mr-3" aria-hidden="true"></MudIcon>
                                    <MudText Typo="Typo.h6">@($"{Children[idxLocal].FirstName} {Children[idxLocal].LastName}")</MudText>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <ChildConfigurationEditor @bind-Child="Children[idxLocal]" ReadOnly="@(ChildBeingEditedId != Children[idxLocal].Id)"></ChildConfigurationEditor>

                                @if (ChildBeingEditedId != Children[idxLocal].Id)
                                {
                                    <MudStack Row="true" Class="settings-actions" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Text" Color="Color.Default"
                                                   OnClick="() => ChildBeingEditedId = Children[idxLocal].Id">Edit</MudButton>
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@IsBusy" OnClick="async () => await DeleteChild(Children[idxLocal])">Delete</MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    // already being edited
                                    <MudStack Row="true" Class="settings-actions" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   Disabled="@IsBusy"
                                                   OnClick="async () => await UpdateChild(Children[idxLocal])">Save</MudButton>
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Text" Color="Color.Default"
                                                   OnClick="async () => await ReloadChildren()">Cancel</MudButton>
                                    </MudStack>
                                }
                            </ChildContent>

                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="empty-state">No children yet. Add one to start tracking allowance.</MudAlert>
            }
        </MudPaper>
    </MudTabPanel>
    <MudTabPanel Icon="@Icons.Material.Filled.Delete" Text="Deleted" BadgeData="DeletedChildren?.Count()">
        <MudPaper Class="settings-card" Elevation="0">
            @if (DeletedChildren is null)
            {
                @if (LoadError is null)
                {
                    <div class="skeleton-stack" role="status" aria-label="Loading deleted children">
                        <span class="skeleton-block skeleton-line skeleton-line-wide"></span>
                        <span class="skeleton-block skeleton-line skeleton-line-medium"></span>
                    </div>
                }
            }
            else if (DeletedChildren.Any())
            {
                <MudTable Items="DeletedChildren" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Child</MudTh>
                        <MudTh>Deleted</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Child">@($"{context.FirstName} {context.LastName}")</MudTd>
                        <MudTd DataLabel="Deleted">@context.UpdatedTimestamp.ToLocalTime().ToString("d")</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@IsBusy"
                                       OnClick="() => RestoreChild(context)">Restore</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="empty-state">Nothing deleted.</MudAlert>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

</div>
