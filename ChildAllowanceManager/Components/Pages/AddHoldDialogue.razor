<MudDialog>
    <TitleContent>Suspend Allowance</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudNumericField Label="Days"
                             @bind-Value="Days"
                             Min="1"
                             Required="true"
                             Immediate="true"/>
            <MudTextField Label="Description"
                          @bind-Value="Description"
                          Required="true"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="AddHold" Disabled="@IsBusy" Color="Color.Primary">Suspend</MudButton>
        <MudButton OnClick="MudDialog.Cancel" Disabled="@IsBusy" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
    @if (IsBusy) { <MudProgressLinear Indeterminate="true" Class="mt-2" aria-label="Saving" /> }
</MudDialog>
