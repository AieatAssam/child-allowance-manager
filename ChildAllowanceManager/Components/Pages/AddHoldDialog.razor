<AppDialog Title="Suspend Allowance" PrimaryActionText="Suspend" OnPrimary="AddHold" IsBusy="@IsBusy">
    <ChildContent>
        <MudForm @ref="_form">
            <MudNumericField Label="Days"
                             @bind-Value="Days"
                             Min="1"
                             Required="true"
                             Immediate="false"/>
            <MudTextField Label="Description"
                          @bind-Value="Description"
                          Required="true"
                          Immediate="false"/>
        </MudForm>
        @if (IsBusy) { <MudProgressLinear Indeterminate="true" Class="mt-2" aria-label="Saving" /> }
    </ChildContent>
</AppDialog>
