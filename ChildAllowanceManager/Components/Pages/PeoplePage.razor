@page "/{tenantSuffix}/people"
@using ChildAllowanceManager.Common.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin,parent")]

<PageTitle>People</PageTitle>

<div class="page-shell settings-view">
    <div class="page-heading">
        <div class="page-heading-copy">
            <MudText Typo="Typo.overline" Class="page-kicker">Family access</MudText>
            <MudText Typo="Typo.h3" HtmlTag="h1" Class="page-title">People</MudText>
            <MudText Color="Color.Secondary">Who can see and manage this family.</MudText>
        </div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@IsBusy" OnClick="InviteParent">
            Invite a parent
        </MudButton>
    </div>

    <MudPaper Class="settings-card" Elevation="0">
        <MudText Typo="Typo.h5">Current members</MudText>
        @if (Members is null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (Members.Length == 0)
        {
            <MudAlert Severity="Severity.Info" Class="empty-state">No members yet.</MudAlert>
        }
        else
        {
            <MudTable Items="Members" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Member since</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.User?.Name</MudTd>
                    <MudTd DataLabel="Email">@context.User?.Email</MudTd>
                    <MudTd DataLabel="Role">@context.Role</MudTd>
                    <MudTd DataLabel="Member since">@context.CreatedTimestamp.ToString("d")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Color="Color.Error" Size="Size.Small" Disabled="@IsBusy"
                                   OnClick="() => RemoveMember(context)">Remove</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Class="settings-card mt-4" Elevation="0">
        <MudText Typo="Typo.h5">Pending invitations</MudText>
        @if (Invitations is null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (Invitations.Length == 0)
        {
            <MudAlert Severity="Severity.Info" Class="empty-state">No pending invitations.</MudAlert>
        }
        else
        {
            <MudTable Items="Invitations" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Invited by</MudTh>
                    <MudTh>Expires</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Role">@context.Role</MudTd>
                    <MudTd DataLabel="Invited by">@context.InvitedByEmail</MudTd>
                    <MudTd DataLabel="Expires">@context.ExpiresAt.ToString("d")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Color="Color.Error" Size="Size.Small" Disabled="@IsBusy"
                                   OnClick="() => WithdrawInvitation(context)">Withdraw</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</div>

<MudMessageBox @ref="Confirmation" Title="Confirm action" CancelText="Cancel">
    <MessageContent>Are you sure you want to continue?</MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error">Confirm</MudButton>
    </YesButton>
</MudMessageBox>
