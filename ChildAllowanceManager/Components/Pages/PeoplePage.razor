@page "/{tenantSuffix}/people"
@using ChildAllowanceManager.Common.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin,parent")]

<PageTitle>People</PageTitle>

<div class="page-shell settings-view">
    <div class="page-heading">
        <div class="page-heading-copy">
            <MudText Typo="Typo.overline" Class="page-kicker">Family access</MudText>
            <MudText Typo="Typo.h3" HtmlTag="h1" Class="page-title">People</MudText>
            <MudText Color="Color.Secondary">Who can see and manage this family.</MudText>
        </div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@IsBusy" OnClick="InviteParent">
            Invite a parent
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" Disabled="@IsBusy" OnClick="CreateShareLink">
            New display link
        </MudButton>
    </div>

    <MudPaper Class="settings-card" Elevation="0">
        <MudText Typo="Typo.h5">Current members</MudText>
        @if (Members is null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (Members.Length == 0)
        {
            <MudAlert Severity="Severity.Info" Class="empty-state">No members yet.</MudAlert>
        }
        else
        {
            <MudTable Items="Members" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Member since</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.User?.Name</MudTd>
                    <MudTd DataLabel="Email">@context.User?.Email</MudTd>
                    <MudTd DataLabel="Role">@context.Role</MudTd>
                    <MudTd DataLabel="Member since">@context.CreatedTimestamp.ToString("d")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Color="Color.Error" Size="Size.Small" Disabled="@IsBusy"
                                   OnClick="() => RemoveMember(context)">Remove</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Class="settings-card mt-4" Elevation="0">
        <MudText Typo="Typo.h5">Pending invitations</MudText>
        @if (Invitations is null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (Invitations.Length == 0)
        {
            <MudAlert Severity="Severity.Info" Class="empty-state">No pending invitations.</MudAlert>
        }
        else
        {
            <MudTable Items="Invitations" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Invited by</MudTh>
                    <MudTh>Expires</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Role">@context.Role</MudTd>
                    <MudTd DataLabel="Invited by">@context.InvitedByEmail</MudTd>
                    <MudTd DataLabel="Expires">@context.ExpiresAt.ToString("d")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Color="Color.Error" Size="Size.Small" Disabled="@IsBusy"
                                   OnClick="() => WithdrawInvitation(context)">Withdraw</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

<MudPaper Class="settings-card mt-4" Elevation="0">
    <MudText Typo="Typo.h5">Display links</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Links that show this family's balances and history on a screen, with no sign-in.
        They cannot change anything. Turn one off and it stops working — right away
        for a new visit, within five minutes on a screen that is already showing it.
    </MudText>
    @if (ShareLinks is null)
    {
        <MudProgressCircular Color="Color.Default" Indeterminate="true" />
    }
    else if (ShareLinks.Length == 0)
    {
        <MudAlert Severity="Severity.Info" Class="empty-state">No display links yet.</MudAlert>
    }
    else
    {
        <MudTable Items="ShareLinks" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Last used</MudTh>
                <MudTh>Stops</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Created">@context.CreatedTimestamp.ToString("d")</MudTd>
                <MudTd DataLabel="Last used">@(context.LastAccessedAt?.ToString("d") ?? "Never")</MudTd>
                <MudTd DataLabel="Stops">
                    @if (context.ExpiresAt < DateTimeOffset.UtcNow)
                    {
                        <MudChip T="string" Color="Color.Warning">Ran out</MudChip>
                    }
                    else
                    {
                        @(context.ExpiresAt is null ? "Never" : context.ExpiresAt.Value.ToString("d"))
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Color="Color.Error" Size="Size.Small" Disabled="@IsBusy"
                               OnClick="() => RevokeShareLink(context)">Turn off</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
</div>

<MudMessageBox @ref="Confirmation" Title="@(_confirmationTitle ?? "Confirm action")" CancelText="Cancel">
    <MessageContent>@(_confirmationMessage ?? "Are you sure you want to continue?")</MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error">Confirm</MudButton>
    </YesButton>
</MudMessageBox>
