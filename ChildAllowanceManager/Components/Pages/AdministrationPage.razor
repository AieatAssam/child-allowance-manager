@page "/admin"
@using ChildAllowanceManager.Common.Models
@using Microsoft.AspNetCore.Authorization
@inject Microsoft.JSInterop.IJSRuntime JS
@attribute [Authorize(Roles = "admin")]
<PageTitle>Administration</PageTitle>

<div class="page-shell settings-view">
    <div class="page-heading">
        <div class="page-heading-copy">
            <MudText Typo="Typo.h3" HtmlTag="h1" Class="page-title">Administration</MudText>
            <MudText Color="Color.Secondary">Create, rename and remove families.</MudText>
        </div>
    </div>

<MudTabs Class="settings-tabs">
    <MudTabPanel Icon="@Icons.Material.Filled.People" Text="Tenants" BadgeData="Tenants?.Count()">
        <MudPaper Class="settings-card" Elevation="0">
            <MudToolBar>
                <MudText Typo="Typo.subtitle1">Families</MudText>
                <MudSpacer/>
                <MudIconButton Icon="@Icons.Material.Outlined.Add" aria-label="Add tenant" Disabled="@IsBusy" OnClick="() => AddingTenant = true"/>
            </MudToolBar>

            @if (Tenants == null)
            {
                <MudProgressCircular Color="Color.Default" Indeterminate="true"/>
            }
            else if (Tenants.Any() || AddingTenant)
            {
                <MudCollapse Expanded="AddingTenant">
                    <MudCard>
                        <MudCardHeader>
                        <MudText Typo="Typo.h5">Add a family</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <TenantConfigurationEditor @bind-Tenant="NewTenant"></TenantConfigurationEditor>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsBusy" OnClick="async () => await AddTenant()">Save</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="() => NewTenant = new TenantConfiguration()">Clear</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudCollapse>
                
                <MudExpansionPanels MultiExpansion="true">
                    @for (int idx = 0; idx < Tenants.Length; idx++)
                    {
                        var idxLocal = idx;
                        <MudExpansionPanel Class="settings-panel">
                            <TitleContent>
                                <div class="d-flex">
                                    <MudIcon Icon="@(TenantBeingEditedId == Tenants[idxLocal].Id ? Icons.Material.Filled.Edit : Icons.Material.Filled.PeopleAlt)"
                                             Class="mr-3"></MudIcon>
                                    <MudText Typo="Typo.h6">@($"{Tenants[idxLocal].TenantName}")</MudText>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudNavLink Href="@($"/{Tenants[idxLocal].UrlSuffix}/children")">Open this family</MudNavLink>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               aria-label="Copy the link to this family"
                                               OnClick="() => CopyFamilyLink(Tenants[idxLocal])" />
                                <TenantConfigurationEditor @bind-Tenant="Tenants[idxLocal]" ReadOnly="@(TenantBeingEditedId != Tenants[idxLocal].Id)"></TenantConfigurationEditor>

                                @if (TenantBeingEditedId != Tenants[idxLocal].Id)
                                {
                                    <MudStack Row="true" Class="settings-actions" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Text" Color="Color.Default"
                                                   OnClick="() => TenantBeingEditedId = Tenants[idxLocal].Id">Edit</MudButton>
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@IsBusy" OnClick="async () => await DeleteTenant(Tenants[idxLocal])">Delete</MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    // already being edited
                                    <MudStack Row="true" Class="settings-actions" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   Disabled="@IsBusy"
                                                   OnClick="async () => await UpdateTenant(Tenants[idxLocal])">Save</MudButton>
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Text" Color="Color.Default"
                                                   OnClick="async () => await ReloadTenants()">Cancel</MudButton>
                                    </MudStack>
                                }
                            </ChildContent>

                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="empty-state">No families yet. Add one to create a new allowance space.</MudAlert>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

<MudMessageBox @ref="DeleteTenantMessageBox" 
               Class="pa-6 ma-3"
               Title="Warning" CancelText="Cancel">
    <MessageContent>
        Delete this family? This hides the family and its children. An administrator can restore it.
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete</MudButton>
    </YesButton>
</MudMessageBox>
</div>

@code {
    private async Task CopyFamilyLink(TenantConfiguration tenant) =>
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.ToAbsoluteUri($"/{tenant.UrlSuffix}/children").ToString());
}
