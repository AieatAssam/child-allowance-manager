@page "/"
<PageTitle>Child Allowance Manager</PageTitle>

@if (!_initialised)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
}
else
{
    <div class="home-state">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="home-alert">
            <MudText Typo="Typo.body1">Please log in or use your secret link to access.</MudText>
            @if (Environment.IsDevelopment())
            {
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">
                    Use local demo account
                </MudButton>
            }
        </MudAlert>
    </div>
}

