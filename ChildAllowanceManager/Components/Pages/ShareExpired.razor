@page "/share/expired"

<PageTitle>This link no longer works</PageTitle>

<div class="page-shell">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        <MudText Typo="Typo.h6" HtmlTag="h1">This link no longer works</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            It was turned off, or it ran out. Ask a parent in the family for a new one.
        </MudText>
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="/login">
            Sign in instead
        </MudButton>
    </MudAlert>
</div>
