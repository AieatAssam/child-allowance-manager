@using System.ComponentModel.DataAnnotations
@using MudBlazor.Utilities
<AppDialog Title="Invite a parent" PrimaryActionText="Send invitation" OnPrimary="AddParentAsync" IsBusy="@IsBusy">
    <ChildContent>
        <MudForm Model="@NewParent" @ref="_form">
            <MudTextField For="() => NewParent.Email" 
                          @bind-Value="NewParent.Email" 
                          InputMode="InputMode.email" 
                          Label="Email"
                          Required="true"
                          Validation="@(new EmailAddressAttribute { ErrorMessage = "Enter a valid email address." })"
                          T="string"></MudTextField>
            <MudTextField For="() => NewParent.Name" 
                          @bind-Value="NewParent.Name" 
                          Required="false"
                          Label="Name (optional)"
                          T="string"></MudTextField>
            <MudText Typo="Typo.caption">They get access the next time they sign in with this address. Invitations expire after 14 days.</MudText>
        </MudForm>
    </ChildContent>
</AppDialog>
