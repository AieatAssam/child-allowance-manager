<AppDialog Title="@($"{Child.Name}’s activity")"
           PrimaryActionText="Done"
           OnPrimary="() => MudDialog.Close()">
    <ChildContent>
        <div class="transactions-dialog-shell">
            <div class="transactions-toolbar">
                <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="transactions-toolbar-label">Activity</MudText>
                <MudCheckBox T="bool"
                             @bind-Value="_hideRegularTransactions"
                             Color="Color.Primary"
                             Class="transactions-filter">
                    Hide daily allowances
                </MudCheckBox>
            </div>
            <ChildTransactionsTable Child="Child" HideRegularTransactions="_hideRegularTransactions"></ChildTransactionsTable>
        </div>
    </ChildContent>
</AppDialog>
