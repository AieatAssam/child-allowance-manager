@page "/{tenantSuffix}/children"
@using ChildAllowanceManager.Common.Models
@using Humanizer
@using Microsoft.AspNetCore.Components.Authorization
@using Plotly.Blazor

<PageTitle>Allowance dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="page-shell">
    <div class="page-heading">
        <div>
            <MudText Typo="Typo.overline" Class="page-kicker">Allowance dashboard</MudText>
            <MudText Typo="Typo.h3" Class="page-title">Your money, your goals</MudText>
            <MudText Color="Color.Secondary">See what you have saved and what is coming next.</MudText>
        </div>
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AutoAwesome">
            Small steps add up
        </MudChip>
    </div>

    <MudGrid Spacing="3">
        @foreach (var child in Children ?? Array.Empty<ChildWithBalance>())
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudCard Class="child-card" Elevation="0" Outlined="true">
                    <MudCardHeader>
                        <MudAvatar Class="child-avatar" Color="@(child.HoldDaysRemaining > 0 ? Color.Warning : Color.Primary)">
                            @child.Name[0]
                        </MudAvatar>
                        <div class="child-card-heading">
                            <MudText Typo="Typo.h6">@child.Name</MudText>
                            @if (child.IsBirthday)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">Birthday bonus day 🎂</MudText>
                            }
                        </div>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h3" Class="@($"balance-value {(child.Balance < 0 ? "balance-negative" : "balance-positive")}")">
                            @child.Balance.ToString("C2")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Current balance</MudText>

                        @if (child.HoldDaysRemaining > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                                Allowance paused for @child.HoldDaysRemaining day(s).
                                <AuthorizeView Roles="admin,parent">
                                    <Authorized>
                                        <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => RemoveHoldDay(child)">
                                            Remove one day
                                        </MudButton>
                                    </Authorized>
                                </AuthorizeView>
                            </MudAlert>
                        }

                        <div class="next-allowance">
                            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Success" />
                            <div>
                                <MudText Typo="Typo.body2">Next allowance</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @child.NextRegularChange.ToString("C2") @child.NextRegularChangeDate.ToLocalTime().Humanize()
                                </MudText>
                            </div>
                        </div>
                    </MudCardContent>
                    <MudCardActions Class="child-card-actions">
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   OnClick="() => ShowTransactionsForChild(child)">
                            History
                        </MudButton>
                        <AuthorizeView Roles="admin,parent">
                            <Authorized>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => ShowAddFundsForChild(child)">
                                    Add
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Remove"
                                           OnClick="() => ShowWithdrawFundsForChild(child)">
                                    Take out
                                </MudButton>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" aria-label="More actions">
                                    <MudMenuItem OnClick="() => ApplyHold(child)" Icon="@Icons.Material.Filled.PauseCircle">
                                        Pause allowance
                                    </MudMenuItem>
                                </MudMenu>
                            </Authorized>
                        </AuthorizeView>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12">
            <MudPaper Class="chart-card" Elevation="0">
                <div class="chart-heading">
                    <div>
                        <MudText Typo="Typo.h5">Balance over time</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Follow each balance and spot progress at a glance.
                        </MudText>
                    </div>
                    <MudTooltip Text="Lines show the balance after each recorded change. A flat section means no money moved.">
                        <MudIconButton Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" aria-label="Explain the chart" />
                    </MudTooltip>
                </div>
                <div class="chart-frame">
                    <PlotlyChart @bind-Config="_plotlyConfig"
                                 @bind-Layout="_plotlyLayout"
                                 @bind-Data="_plotlyData"
                                 @ref="_plotlyChart" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
