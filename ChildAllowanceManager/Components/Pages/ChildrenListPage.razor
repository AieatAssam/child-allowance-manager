@page "/{tenantSuffix}/children"
@page "/share/{shareToken}"
@using ChildAllowanceManager.Common.Models
@using Humanizer
@using System.Globalization

<PageTitle>Allowance dashboard</PageTitle>

<div class="@($"dashboard-view {(_shareMode ? "share-display" : string.Empty)}")">
    <MudContainer MaxWidth="MaxWidth.Large" Class="page-shell">
        <div class="page-heading">
            <div class="page-heading-copy">
                <MudText Typo="Typo.h3" HtmlTag="h1" Class="page-title">Balances</MudText>
                <MudText Color="Color.Secondary">What each child has, and what is coming next.</MudText>
            </div>
            @if (Children?.FirstOrDefault() is { } firstChild)
            {
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.WbSunny">
                    @TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(firstChild.TimeZoneId)).ToString("dddd, d MMMM")
                </MudChip>
            }
        </div>

        <MudGrid Spacing="3">
        @foreach (var child in Children ?? Array.Empty<ChildWithBalance>())
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudCard Class="@($"child-card {(child.IsBirthday ? "child-birthday " : string.Empty)}child-accent-{GetChildAccentIndex(child.Id)}")" Elevation="0" Outlined="true">
                    <MudCardHeader Class="child-card-header">
                        <MudAvatar Class="child-avatar" Color="@(child.HoldDaysRemaining > 0 ? Color.Warning : Color.Primary)" aria-hidden="true">
                            @child.Name[0]
                        </MudAvatar>
                        <div class="child-card-heading">
                            <MudText Typo="Typo.h6">@child.Name</MudText>
                            @if (child.IsBirthday)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="birthday-label">
                                    <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Small" aria-hidden="true" /> Birthday allowance today
                                </MudText>
                            }
                        </div>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h3"
                                 Class="@($"balance-value {(child.Balance < 0 ? "balance-negative" : "balance-positive")}")"
                                 data-balance-value="@child.Balance.ToString(CultureInfo.InvariantCulture)"
                                 data-balance-motion-direction="@GetBalanceMotionDirection(child.Id)"
                                 data-balance-motion-version="@GetBalanceMotionVersion(child.Id)">
                            @child.Balance.ToString("C2")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Current balance</MudText>

                        @if (child.HoldDaysRemaining > 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="allowance-paused">
                                Allowance is paused for @GetHoldDaysLabel(child.HoldDaysRemaining).
                                @if (CanManageCurrentTenant)
                                {
                                        <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => RemoveHoldDay(child)">
                                            Remove one day
                                        </MudButton>
                                }
                            </MudAlert>
                        }

                        <div class="next-allowance">
                            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Success" aria-hidden="true" />
                            <div>
                                <MudText Typo="Typo.body2">Next allowance</MudText>
                                <MudText Typo="Typo.body2">
                                    @child.NextRegularChange.ToString("C2") on @child.NextRegularChangeLocalDate.ToString("dddd, d MMMM")
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @child.NextRegularChangeDate.ToLocalTime().Humanize()
                                </MudText>
                            </div>
                        </div>
                    </MudCardContent>
                    <MudCardActions Class="@($"child-card-actions{(CanManageCurrentTenant ? string.Empty : " child-card-actions-readonly")}")">
                        <MudButton Class="card-action action-history" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   OnClick="() => ShowTransactionsForChild(child)">
                            History
                        </MudButton>
                        @if (CanManageCurrentTenant)
                        {
                                <MudButton Class="card-action action-add" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => ShowAddFundsForChild(child)">
                                    Add money
                                </MudButton>
                                <MudButton Class="card-action action-withdraw" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Remove"
                                           OnClick="() => ShowWithdrawFundsForChild(child)">
                                    Withdraw
                                </MudButton>
                                <MudMenu Class="card-more" Icon="@Icons.Material.Filled.MoreVert" aria-label="More actions">
                                    <MudMenuItem OnClick="() => ApplyHold(child)" Icon="@Icons.Material.Filled.PauseCircle">
                                        Pause allowance
                                    </MudMenuItem>
                                </MudMenu>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12">
            <MudPaper Class="chart-card" Elevation="0">
                <div class="chart-heading">
                    <div>
                        <MudText Typo="Typo.subtitle1">Balance over time</MudText>
                        <MudText Typo="Typo.body2" Class="chart-support">
                            Balance for each child over recent days.
                        </MudText>
                    </div>
                    @if (_balanceChartSeries.Count > 0)
                    {
                        <div class="chart-legend" aria-label="Balance lines">
                            @for (var index = 0; index < _balanceHistory.Length; index++)
                            {
                                <span class="chart-legend-item">
                                    <span class="chart-legend-swatch chart-color-@GetChildAccentIndex(_balanceHistory[index].ChildId)" aria-hidden="true"></span>
                                    @_balanceHistory[index].ChildName
                                </span>
                            }
                        </div>
                    }
                </div>
                @if (HasBalanceHistory)
                {
                    <div class="chart-note" id="balance-chart-description">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" aria-hidden="true" />
                        <span>Tap or hover a point to see that day’s balance.</span>
                    </div>
                    <div class="chart-frame" aria-hidden="true">
                        <MudChart T="decimal"
                                  ChartType="ChartType.Timeseries"
                                  ChartSeries="_balanceChartSeries"
                                  ChartOptions="_balanceChartOptions"
                                  Width="100%"
                                  Height="200px"
                                  MatchBoundsToSize="true" />
                    </div>
                }
                else
                {
                    <div class="chart-empty-state" id="balance-chart-description">
                        <MudIcon Icon="@Icons.Material.Outlined.ShowChart" aria-hidden="true" />
                        <div>
                            <MudText Typo="Typo.subtitle2">Your balance story starts here</MudText>
                            <MudText Typo="Typo.body2">Add money or wait for an allowance to see the line grow.</MudText>
                        </div>
                    </div>
                }
                <MudExpansionPanels>
                    <MudExpansionPanel Text="View the data as a table" Expanded="false" aria-describedby="balance-chart-description">
                        <BalanceHistoryTable History="_balanceHistory" AccentIndex="GetChildAccentIndex" />
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
        </MudItem>
        </MudGrid>
    </MudContainer>
</div>
