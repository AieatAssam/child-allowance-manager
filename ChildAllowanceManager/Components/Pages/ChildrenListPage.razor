@page "/{tenantSuffix}/children"
@using ChildAllowanceManager.Common.Models
@using Humanizer
@using Microsoft.AspNetCore.Components.Authorization
@using Plotly.Blazor

<PageTitle>Allowance dashboard</PageTitle>

<div class="dashboard-view">
    <div class="dashboard-backdrop" aria-hidden="true">
        <span class="dashboard-ribbon dashboard-ribbon-one"></span>
        <span class="dashboard-ribbon dashboard-ribbon-two"></span>
        <span class="dashboard-ribbon dashboard-ribbon-three"></span>
        <span class="dashboard-orb dashboard-orb-one"></span>
        <span class="dashboard-orb dashboard-orb-two"></span>
        <span class="dashboard-spark dashboard-spark-one"></span>
        <span class="dashboard-spark dashboard-spark-two"></span>
    </div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="page-shell">
        <div class="page-heading">
            <div class="page-heading-copy">
                <MudText Typo="Typo.overline" Class="page-kicker">Pocket money</MudText>
                <MudText Typo="Typo.h3" Class="page-title">Money in. Money out.</MudText>
                <MudText Color="Color.Secondary">See what’s saved, what’s spent, and what’s next.</MudText>
            </div>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.WbSunny">
                Today at a glance
            </MudChip>
        </div>

        <MudGrid Spacing="3">
        @foreach (var child in Children ?? Array.Empty<ChildWithBalance>())
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudCard Class="child-card" Elevation="0" Outlined="true">
                    <MudCardHeader>
                        <MudAvatar Class="child-avatar" Color="@(child.HoldDaysRemaining > 0 ? Color.Warning : Color.Primary)">
                            @child.Name[0]
                        </MudAvatar>
                        <div class="child-card-heading">
                            <MudText Typo="Typo.h6">@child.Name</MudText>
                            @if (child.IsBirthday)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">Birthday bonus day 🎂</MudText>
                            }
                        </div>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h3" Class="@($"balance-value {(child.Balance < 0 ? "balance-negative" : "balance-positive")}")">
                            @child.Balance.ToString("C2")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Current balance</MudText>

                        @if (child.HoldDaysRemaining > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                                Allowance paused for @child.HoldDaysRemaining day(s).
                                <AuthorizeView Roles="admin,parent">
                                    <Authorized>
                                        <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => RemoveHoldDay(child)">
                                            Remove one day
                                        </MudButton>
                                    </Authorized>
                                </AuthorizeView>
                            </MudAlert>
                        }

                        <div class="next-allowance">
                            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Success" />
                            <div>
                                <MudText Typo="Typo.body2">Next allowance</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @child.NextRegularChange.ToString("C2") @child.NextRegularChangeDate.ToLocalTime().Humanize()
                                </MudText>
                            </div>
                        </div>
                    </MudCardContent>
                    <MudCardActions Class="child-card-actions">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   OnClick="() => ShowTransactionsForChild(child)">
                            History
                        </MudButton>
                        <AuthorizeView Roles="admin,parent">
                            <Authorized>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => ShowAddFundsForChild(child)">
                                    Add
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Remove"
                                           OnClick="() => ShowWithdrawFundsForChild(child)">
                                    Take out
                                </MudButton>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" aria-label="More actions">
                                    <MudMenuItem OnClick="() => ApplyHold(child)" Icon="@Icons.Material.Filled.PauseCircle">
                                        Pause allowance
                                    </MudMenuItem>
                                </MudMenu>
                            </Authorized>
                        </AuthorizeView>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12">
            <MudPaper Class="chart-card" Elevation="0">
                <div class="chart-heading">
                    <div>
                        <MudText Typo="Typo.h5">Balance over time</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Follow the ups, downs, and spending choices behind each balance.
                        </MudText>
                    </div>
                    <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Insights">
                        Compare balances
                    </MudChip>
                </div>
                <div class="chart-note" id="balance-chart-description">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" aria-hidden="true" />
                    <span>Hover a point to compare balances on the same day.</span>
                </div>
                <div class="chart-frame" role="img" aria-label="Balance over time chart" aria-describedby="balance-chart-description">
                    <PlotlyChart @bind-Config="_plotlyConfig"
                                 @bind-Layout="_plotlyLayout"
                                 @bind-Data="_plotlyData"
                                 @ref="_plotlyChart" />
                </div>
            </MudPaper>
        </MudItem>
        </MudGrid>
    </MudContainer>
</div>
