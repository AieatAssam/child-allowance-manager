@using Microsoft.AspNetCore.Components.Authorization
<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized Context="authState">
                <LayoutView Layout="@typeof(Layout.MainLayout)">
                    <div class="page-shell">
                        @if (authState.User.Identity?.IsAuthenticated == true)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <MudText Typo="Typo.h6" HtmlTag="h1">You do not have access to this page</MudText>
                                <MudText Typo="Typo.body2" Class="mt-2">
                                    You are signed in as @authState.User.Identity.Name.
                                    Ask a parent in that family to invite you, or choose a family you can open.
                                </MudText>
                                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="/">
                                    Choose a family
                                </MudButton>
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                <MudText Typo="Typo.h6" HtmlTag="h1">Sign in to continue</MudText>
                                <MudText Typo="Typo.body2" Class="mt-2">This page is for signed-in parents.</MudText>
                                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="/login">
                                    Sign in
                                </MudButton>
                            </MudAlert>
                        }
                    </div>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="#main-content"/>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <div class="page-shell">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    That page does not exist. <MudLink Href="/">Back to families</MudLink>
                </MudAlert>
            </div>
        </LayoutView>
    </NotFound>
</Router>
