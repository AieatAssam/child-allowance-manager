<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="2">
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           aria-label="@($"Close {Title}")"
                           OnClick="MudDialog.Cancel" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        @ChildContent
    </DialogContent>
    <DialogActions>
        @if (Actions is not null)
        {
            @Actions
        }
        else
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@IsBusy"
                       OnClick="MudDialog.Cancel">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(IsBusy || PrimaryDisabled)"
                       OnClick="HandlePrimaryAsync">@PrimaryActionText</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string PrimaryActionText { get; set; } = "Save";
    [Parameter] public EventCallback OnPrimary { get; set; }
    [Parameter] public bool PrimaryDisabled { get; set; }
    [Parameter] public new bool IsBusy { get; set; }

    private Task HandlePrimaryAsync() => OnPrimary.InvokeAsync();
}
